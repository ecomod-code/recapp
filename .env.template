SERVER_PORT=3123
SERVER_HOST=127.0.0.1

# Public domain the Caddy reverse proxy answers on (prod/test only, not used in dev)
DOMAIN=YOURDOMAINHERE

FRONTEND_URI=http://localhost:5173
# BACKEND_URI must include the /api prefix in prod/test (path-based proxy routing
# strips it before forwarding to the backend), e.g. https://YOURDOMAINHERE/api
BACKEND_URI=http://localhost:3123

OPENID_PROVIDER=YOURPROVIDERURLHERE
OID_CLIENT_ID=SECRETID
OID_CLIENT_SECRET=SUPERSECRETSECRET
ISSUER=GRANTISSUER
# OIDC callback path appended to BACKEND_URI
REDIRECT_URI=/auth/callback
# Set to true if the OIDC provider needs offline_access to issue refresh tokens
REQUIRES_OFFLINE_SCOPE=false

API_KEYS=ADDUIDSYOUWANTTOUSEASAPIKEYS_AS_A_COMMA_SEPERATED_LIST

MONGODB_HOST=recapp-db
MONGODB_PORT=27017
MONGODB_USER=recapp
MONGODB_PW=YOURMONGOPW

JWT_SECRET=YOURJWTSECRET

DEBUG_RECAPP=0
LOG_LEVEL=info
